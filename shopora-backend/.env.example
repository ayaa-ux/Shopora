# Copier ce fichier en ".env" et remplir les valeurs. Ne JAMAIS commiter ".env".

POSTGRES_USER=shopora
POSTGRES_PASSWORD=change-me

# Secret de signature des JWT (>= 32 caracteres, identique pour tous les services)
# Generer : openssl rand -hex 48
JWT_SECRET=change-me-with-a-long-random-string

# Cle partagee entre catalog-service, order-service et ai-assistant-service
INTERNAL_API_KEY=change-me

# Assistant IA (API compatible OpenAI, ex. Groq)
AI_API_KEY=your-api-key
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
